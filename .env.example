# Copy this file to .env and fill in real values. Never commit .env.
# The .env file is gitignored; .env.example is the committed template.

# --- RentRight FastAPI backend (public URL, no secret) ---
# Set this after deploying the Python backend, e.g. https://your-api-host.example
VITE_CHAT_API_URL=

# --- Gemini (legacy frontend chat; do not expose a real secret in production) ---
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.5-flash

# --- NVIDIA Nemotron (chat assistant) ---
# SECRET: intentionally NO VITE_ prefix. Read only server-side by the
# /api/nemotron proxy (Vite dev middleware + Vercel function). On Vercel, set
# this in Project Settings > Environment Variables and redeploy.
NVIDIA_API_KEY=
# Non-secret model id, safe in the client bundle:
VITE_NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b

# --- Outpero AI voice-agent calls ---
# SECRET: intentionally NO VITE_ prefix. Injected server-side by the Vite dev
# proxy (/outpero-api) in vite.config.ts so the key is never shipped to the browser.
OUTPERO_API_KEY=
# Public (non-secret) default AI-agent employee id used by the call widget:
VITE_OUTPERO_EMPLOYEE_ID=
# Optional: override the proxy base if you deploy behind your own signing backend.
# VITE_OUTPERO_BASE=/outpero-api
