# Choose: nvidia, openai-compatible, or ollama
LLM_PROVIDER=nvidia

# NVIDIA hosted OpenAI-compatible endpoint
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_API_KEY=

# For an OpenAI-compatible self-hosted provider instead:
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL=your-served-model-name
# LLM_API_KEY=

# For Ollama's OpenAI-compatible endpoint:
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=nemotron
# LLM_API_KEY=ollama

# Comma-separated exact browser origins. Never use * in production.
ALLOWED_ORIGINS=https://rent-right-beta.vercel.app,http://localhost:5173

MAX_MESSAGES=24
MAX_MESSAGE_CHARS=6000
MAX_OUTPUT_TOKENS=800
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# Persistent database: SQLite for local development; use managed PostgreSQL in production.
DATABASE_URL=sqlite:///./rentright.db

# Firebase ID-token verification (same Firebase project as the frontend).
FIREBASE_PROJECT_ID=
# Optional explicit service-account credentials path if workload identity is not available.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# Comma-separated Firebase UIDs authorized for admin endpoints; do not use email/client role claims.
FIREBASE_ADMIN_UIDS=
